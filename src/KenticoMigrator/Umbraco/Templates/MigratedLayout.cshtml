@using Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    var title = Model.Value<string>("metaTitle");
    if (string.IsNullOrWhiteSpace(title)) { title = Model.Name; }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    @if (!string.IsNullOrWhiteSpace(Model.Value<string>("metaDescription")))
    {
        <meta name="description" content="@Model.Value<string>("metaDescription")" />
    }
</head>
<body>
    <main>
        @RenderBody()
    </main>
</body>
</html>
